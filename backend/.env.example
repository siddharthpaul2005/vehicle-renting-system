# Copy to backend/.env and fill in. This file is safe to commit; .env is not.
DB_URL=jdbc:postgresql://localhost:5432/drivexpress
DB_USERNAME=postgres
DB_PASSWORD=your-local-password
# At least 32 random characters
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Optional
# PORT=8080
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# SEED_DATA=true
# ADMIN_EMAIL=admin@drivexpress.com
# ADMIN_PASSWORD=admin1234
# DEMO_PASSWORD=demo1234

# Neon example (later):
# DB_URL=jdbc:postgresql://<host>.neon.tech/neondb?sslmode=require
# DB_USERNAME=neondb_owner
# DB_PASSWORD=<neon-password>
